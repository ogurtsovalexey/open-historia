{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "downlevelIteration": true,
    "lib": ["ES2020"]
  },
  "include": ["src/**/*"],
  "exclude": ["test", "dist", "node_modules"]
}