{
  "name": "open-historia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "agents:install": "bash scripts/agent-orchestrator.sh install",
    "agents:start": "bash scripts/agent-orchestrator.sh start",
    "agents:status": "bash scripts/agent-orchestrator.sh status",
    "agents:stop": "bash scripts/agent-orchestrator.sh stop",
    "agents:check": "bash scripts/agent-orchestrator.sh check",
    "agents:run-now": "bash scripts/agent-orchestrator.sh run-now",
    "agents:workers": "bash scripts/agent-worker.sh status",
    "agents:test": "bash scripts/agent-orchestrator.test.sh && bash scripts/agent-worker.test.sh",
    "dev": "vite",
    "dev:web": "node scripts/seed-web-defaults.mjs && vite --mode web",
    "build": "vite build",
    "build:web": "node scripts/seed-web-defaults.mjs && vite build --mode web --outDir dist-web --emptyOutDir",
    "build:site": "node scripts/seed-web-defaults.mjs && vite build --mode web --base /play/ --outDir dist-web --emptyOutDir && node scripts/assemble-site.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web",
    "test": "cd packages/domain && npm run build:tests && cd ../.. && node --test \"server/**/*.test.js\" \"src/**/*.test.js\" \"packages/domain/dist-test/test/*.test.js\"",
    "test:server": "node --test \"server/**/*.test.js\"",
    "test:domain": "cd packages/domain && npm test",
    "build:domain": "cd packages/domain && npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "cd packages/domain && npm run typecheck",
    "check:cycles": "cd packages/domain && npm run check:cycles",
    "ci": "npm run lint && npm run test && npm run build && npm run agents:test && npm run check:cycles",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "@turf/area": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "@turf/line-split": "^7.3.5",
    "@turf/polygon-to-line": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "dayjs": "^1.11.19",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "express": "^5.1.0",
    "geotiff": "^3.0.5",
    "globals": "^16.5.0",
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.19.0",
    "ol": "^10.9.0",
    "ol-pmtiles": "^2.0.2",
    "pmtiles": "^4.4.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "shpjs": "^6.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.2"
  },
  "optionalDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.arkniem.openhistoria",
    "productName": "Open Historia",
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "scripts/fetch-map-assets.mjs",
      "scripts/map-assets.json",
      "public/lang/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "scripts/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "artifactName": "Open-Historia-Setup-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Historia",
      "artifactName": "Open-Historia-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.strategy-games",
      "artifactName": "Open-Historia-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "Game",
      "artifactName": "Open-Historia-${arch}.${ext}"
    }
  }
}
